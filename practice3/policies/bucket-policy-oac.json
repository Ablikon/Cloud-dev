{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOnlyThisCloudFrontDistribution",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cad-web-32d6c4d4/*",
      "Condition": { "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::412004015750:distribution/E2HQQRY16WBS7D" } }
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [ "arn:aws:s3:::cad-web-32d6c4d4", "arn:aws:s3:::cad-web-32d6c4d4/*" ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
